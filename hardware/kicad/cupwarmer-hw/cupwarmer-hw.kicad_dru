(version 1)
# Custom Design Rules (DRC) for KiCAD 8.0 (Stored in '<project>.kicad_dru' file).
#
# Matching JLCPCB capabilities: https://jlcpcb.com/capabilities/pcb-capabilities
# Matching JLCPCB BGA guide:
# https://jlcpcb.com/help/article/bga-design-guidelines---pcb-layout-recommendations-for-bga-packages
# Additional Seeed Fusion Advanced PCB stricter overlays:
# https://support.seeed.cc/portal/en/kb/articles/fusion-advanced-pcb-specification
#
# Project target:
# - 4-layer FR-4 PCB, SIG / GND / GND / SIG.
# - STWLC38JRM WLCSP40, 0.4 mm pitch, 0.25 mm BGA pads.
# - Standard through vias only; no blind/buried/microvias.
# - Via-in-pad / filled / capped vias are not assumed for v1.
#
# KiCad documentation: https://docs.kicad.org/master/id/pcbnew/pcbnew_advanced.html#custom_design_rules
#
# Inspiration
# - https://gist.github.com/darkxst/f713268e5469645425eed40115fb8b49 (with comments)
# - https://gist.github.com/denniskupec/e163d13b0a64c2044bd259f64659485e (with comments)

# TODO new rule: NPTH pads.
# Inner diameter of pad should be 0.4-0.5 mm larger than NPTH drill diameter.
# JLCPCB: "We make NPTH via dry sealing film process, if customer would like a NPTH but around with pad/copper, our engineer will dig out around pad/copper about 0.2mm-0.25mm, otherwise the metal potion will be flowed into the hole and it becomes a PTH. (there will be no copper dig out optimization for single board)."

# TODO: new rule for plated slots: min diameter/width 0.5mm
# JLCPCB: "The minimum plated slot width is 0.5mm, which is drawn with a pad."

# TODO new rule: non-plated slots: min diameter/width 1.0mm
# JLCPCB: "The minimum Non-Plated Slot Width is 1.0mm, please draw the slot outline in the mechanical layer(GML or GKO)""


# --- Drill/Hole Size ---

(rule "JLCPCB: Drill Hole Size"
  # Choose between:
  # 1-2 Layers
	# (constraint hole_size (min 0.3mm) (max 6.3mm))
  # 4-6 Layers (more costly)
	(constraint hole_size (min 0.15mm) (max 6.3mm))
  # 4-6 Layers (preferred)
	# (constraint hole_size (min 0.2mm) (max 6.3mm))	
)

(rule "JLCPCB: Via Hole Size"
	(condition "A.Type == 'Via'")
  # Choose between:
  # 1-2 Layers
	# (constraint hole_size (min 0.3mm))
  # 4-layer BGA: JLCPCB BGA guide, H = 0.15 mm
  (constraint hole_size (min 0.15mm))
  # 4-6 Layers (preferred)
  # (constraint hole_size (min 0.2mm))
)

(rule "JLCPCB: Via Copper Diameter"
	(condition "A.Type == 'Via'")
  # 4-layer BGA: JLCPCB BGA guide, P = 0.25 mm.
	(constraint via_diameter (min 0.25mm))
)

(rule "JLCPCB: Via Annular Ring"
	(condition "A.Type == 'Via'")
  # 4-layer BGA: 0.25 mm copper diameter with 0.15 mm drill leaves 0.05 mm ring.
  (constraint annular_width (min 0.05mm))
  # 1-6 Layers (preferred)
  # (constraint annular_width (min 0.075mm))
)

(rule "JLCPCB: PTH Hole Size"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated()")
	(constraint hole_size (min 0.2mm) (max 6.3mm))
)

(rule "JLCPCB: NPTH Hole Size"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && !A.isPlated()")
	(constraint hole_size (min 0.5mm))
)

# TODO: Hole to board edge ≥ 1 mm. Min. board size 10 × 10 mm.
(rule "JLCPCB: Castellated Hole Size"
	(layer outer)
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'Castellated pad'")
	(constraint hole_size (min 0.6mm))
)

(rule "JLCPCB: PTH Annular Ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated()")
	(constraint annular_width (min 0.075mm))
)

(rule "JLCPCB: NPTH Annular Ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && !A.isPlated()")
	(constraint annular_width (min 0.25mm))
)

# Cost note: JLCPCB may add a 4-wire Kelvin test for holes < 0.3 mm with
# copper diameter <= 0.4 mm. That is not a manufacturability limit, and this
# board needs 0.15/0.25 mm BGA breakout vias, so do not enforce avoidance here.


# --- VIA Support Rules --- 

(rule "JLCPCB: Only Throughhole VIAs are supported" 
	(condition "A.Type == 'Via'")
	(constraint assertion "!(A.isBlindBuriedVia() || A.isMicroVia())")
)


# --- Minimum Clearance ---

(rule "JLCPCB: Hole to Hole Clearance (Different Nets)"
	(condition "A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm))
)

(rule "JLCPCB: Via Hole to Via Hole Clearance (Same Net)"
	(condition "A.Type == 'Via' && B.Type == 'Via' && A.Net == B.Net")
	(constraint hole_to_hole (min 0.254mm))
)

(rule "JLCPCB: Pad to Pad Clearance (Pad without Hole, Different Nets)"
	(condition "A.Type == 'Pad' && (A.Pad_Type != 'Through-hole' && A.Pad_Type != 'NPTH, mechanical') && B.Type == 'Pad' && (B.Pad_Type != 'Through-hole' && B.Pad_Type != 'NPTH, mechanical') && A.Net != B.Net")
	(constraint clearance (min 0.127mm))
)

(rule "JLCPCB: Pad Hole to Pad Hole Clearance (Pad with Hole, Different Nets)"
	(condition "A.Type == 'Pad' && (A.Pad_Type == 'Through-hole' || A.Pad_Type == 'NPTH, mechanical') && B.Type == 'Pad' && (B.Pad_Type == 'Through-hole' || B.Pad_Type == 'NPTH, mechanical') && A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm))
)

# NOTE: This is not stated specifically, but is implied by other rules.
(rule "JLCPCB: Via/Pad to Via/Pad Clearance (Different Nets)"
	(condition "(A.Type == 'Pad' || A.Type == 'Via') && (B.Type == 'Pad' || B.Type == 'Via') && A.Net != B.Net")
	(constraint clearance (min 0.127mm))
)

(rule "JLCPCB: BGA Pad Size"
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'BGA pad'")
  # 4-layer BGA: JLCPCB BGA guide, B = 0.25 mm.
	(constraint assertion "A.Size_X >= 0.25mm && A.Size_Y >= 0.25mm")
)

(rule "JLCPCB: BGA Pad to BGA Pad"
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'BGA pad' && B.Type == 'Pad' && B.Fabrication_Property == 'BGA pad'")
  # 0.4 mm pitch with 0.25 mm pads leaves 0.15 mm copper gap.
  # Keep this below the generic 0.2 mm board setup clearance but above
  # JLCPCB 4-layer BGA trace-to-pad/via-to-pad limits.
	(constraint clearance (min 0.127mm))
)

(rule "JLCPCB: BGA Pad to Trace"
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'BGA pad' && B.Type == 'Track' && A.Net != B.Net")
  # 4-layer BGA: JLCPCB BGA guide, C = 0.10 mm.
	(constraint clearance (min 0.10mm))
)

(rule "JLCPCB: Via Copper to BGA Pad"
	(condition "A.Type == 'Via' && B.Type == 'Pad' && B.Fabrication_Property == 'BGA pad' && A.Net != B.Net")
  # 4-layer BGA: JLCPCB BGA guide, G = 0.10 mm.
	(constraint clearance (min 0.10mm))
)

# NOTE: This is not stated specifically, but is implied by other rules.
(rule "JLCPCB: Via/Pad Hole to Via/Pad Hole Clearance (Same Net)"
	(condition "(A.Type == 'Pad' || A.Type == 'Via') && (B.Type == 'Pad' || B.Type == 'Via') && A.Net == B.Net")
	(constraint hole_to_hole (min 0.254mm))
)

(rule "JLCPCB: Via to Trace"
	(condition "A.Type == 'Via' && B.Type == 'Track'")
	(constraint hole_clearance (min 0.254mm))
)

(rule "JLCPCB: PTH to Trace"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated() && B.Type == 'Track'")
	(constraint hole_clearance (min 0.33mm))
)

(rule "JLCPCB: NPTH to Trace"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && !A.isPlated() && B.Type == 'Track'")
	(constraint hole_clearance (min 0.254mm))
)

(rule "JLCPCB: Pad to Trace"
	(condition "A.Type == 'Pad' && (A.Pad_Type == 'Through-hole' || A.Pad_Type == 'NPTH, mechanical') && B.Type == 'Track' &&  A.Net != B.Net")
	(constraint clearance (min 0.2mm))
)


# --- Minimum Trace Width and Spacing ---

(rule "JLCPCB: Trace Width (Outer Layer)"
	(layer outer)
	(condition "A.Type == 'Track'")
  # Choose between:
  # 1-2 Layers (1oz)
  # (constraint track_width (min 0.127mm))
  # 4-6 Layers (1oz and 0.5oz)
	(constraint track_width (min 0.09mm))
  # 1-6 Layers (2oz)
  # (constraint track_width (min 0.2mm))
)
(rule "JLCPCB: Trace Spacing (Outer Layer)"
	(layer outer)
	(condition "A.Type == 'Track' && B.Type == 'Track'")
  # Choose between:
  # 1-2 Layers (1oz)
  # (constraint clearance (min 0.127mm))
  # 4-6 Layers (1oz and 0.5oz)
	(constraint clearance (min 0.09mm))
  # 1-6 Layers (2oz)
  # (constraint clearance (min 0.2mm))
)

(rule "JLCPCB: Trace Width (Inner Layer)"
	(layer inner)
	(condition "A.Type == 'Track'")
  # Choose between:
  # 4-6 Layers (1oz and 0.5oz)
	(constraint track_width (min 0.09mm))
  # 4-6 Layers (2oz)
  # (constraint track_width (min 0.2mm))
)
(rule "JLCPCB: Trace Spacing (Inner Layer)"
	(layer inner)
	(condition "A.Type == 'Track' && B.Type == 'Track'")
  # Choose between:
  # 4-6 Layers (1oz and 0.5oz)
	(constraint clearance (min 0.09mm))
  # 4-6 Layers (2oz)
  # (constraint clearance (min 0.2mm))
)

# --- U1 BGA Escape ---
#
# Keep POWER/SENSE/Default netclasses conservative for the rest of the board.
# These local exceptions allow only the STWLC38JRM WLCSP40 fanout area to use
# JLCPCB 4-layer BGA limits. Rules are intentionally placed after the generic
# clearance/width rules because KiCad evaluates custom rules from bottom to top.

(rule "JLCPCB: U1 BGA Escape Track Width"
	(condition "A.Type == 'Track' && A.intersectsCourtyard('U1')")
  # JLCPCB 4-layer BGA guide: trace width can use 0.09 mm in the fanout.
	(constraint track_width (min 0.09mm))
)

(rule "JLCPCB: U1 BGA Escape Clearance"
	(condition "A.intersectsCourtyard('U1') || B.intersectsCourtyard('U1')")
  # JLCPCB 4-layer BGA guide: trace-to-trace spacing S = 0.09 mm.
  # BGA pad-to-trace and via-to-BGA-pad are separately constrained to 0.10 mm.
	(constraint clearance (min 0.09mm))
)

(rule "JLCPCB: U1 BGA Escape Via Hole to Trace"
	(condition "((A.Type == 'Via' && B.Type == 'Track') || (A.Type == 'Track' && B.Type == 'Via')) && (A.intersectsCourtyard('U1') || B.intersectsCourtyard('U1'))")
  # For 0.25/0.15 mm BGA escape vias, 0.09 mm copper-to-copper spacing
  # corresponds to 0.14 mm from the drill edge to adjacent copper.
	(constraint hole_clearance (min 0.14mm))
)

(rule "JLCPCB: U1 BGA Escape Via Hole to Via Hole"
	(condition "A.Type == 'Via' && B.Type == 'Via' && A.Net != B.Net && (A.intersectsCourtyard('U1') || B.intersectsCourtyard('U1'))")
  # U1 uses the JLCPCB 4-layer BGA escape process: 0.15 mm drill /
  # 0.25 mm via copper. Keep the generic 0.5 mm different-net
  # hole-to-hole rule for the rest of the board, but allow the dense BGA
  # fanout via cluster around U1.
	(constraint hole_to_hole (min 0.25mm))
)


# --- Seeed Fusion Advanced PCB stricter overlays ---
#
# These rules keep the JLCPCB-oriented rules above in place, and only add
# Fusion Advanced constraints that are stricter for the current 4-layer,
# nominal 1 oz outer / 1 oz inner copper assumption.
#
# Relevant Seeed limits:
# - Outer 1 oz copper trace/spacing: 5/5 mil = 0.127 mm.
# - Inner 1 oz copper trace/spacing: 4/4 mil = 0.1016 mm.
# - Via annular ring: 4 mil = 0.1016 mm.  For this board's 0.15 mm
#   minimum via drill, that requires at least 0.3532 mm via copper diameter.
#   U1 fanout vias intentionally use the JLCPCB 4-layer BGA process
#   limit above: 0.25 mm copper / 0.15 mm drill = 0.05 mm annular ring.
# - Through-hole annular ring: 8 mil = 0.2032 mm.
# - Different-net via wall spacing: 9 mil prototype / 12 mil mass production.
#   The generic JLCPCB 0.5 mm rule is already stricter, except the U1 BGA
#   fanout exception remains above the 9 mil prototype limit.
#

(rule "Seeed Fusion Advanced: Via Annular Ring"
	(condition "A.Type == 'Via' && !A.intersectsCourtyard('U1')")
	(constraint assertion "A.Diameter >= A.Hole + 0.2032mm")
)

(rule "Seeed Fusion Advanced: PTH Annular Ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated()")
	(constraint assertion "A.Size_X >= A.Hole_Size_X + 0.4064mm && A.Size_Y >= A.Hole_Size_Y + 0.4064mm")
)

(rule "Seeed Fusion Advanced: Trace Width (Outer 1oz)"
	(layer outer)
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.127mm))
)

(rule "Seeed Fusion Advanced: Trace Spacing (Outer 1oz)"
	(layer outer)
	(condition "A.Type == 'Track' && B.Type == 'Track' && A.Net != B.Net && !A.intersectsCourtyard('U1') && !B.intersectsCourtyard('U1')")
	(constraint clearance (min 0.127mm))
)

(rule "Seeed Fusion Advanced: Trace Width (Inner 1oz)"
	(layer inner)
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.1016mm))
)

(rule "Seeed Fusion Advanced: Trace Spacing (Inner 1oz)"
	(layer inner)
	(condition "A.Type == 'Track' && B.Type == 'Track' && A.Net != B.Net")
	(constraint clearance (min 0.1016mm))
)

(rule "DFM Warning: Trace Spacing (F.Cu)"
	(layer "F.Cu")
	(condition "A.Type == 'Track' && B.Type == 'Track' && !A.intersectsCourtyard('U1') && !B.intersectsCourtyard('U1')")
	(constraint clearance (min 0.15mm))
	(severity warning)
)

(rule "DFM Warning: Trace Spacing (B.Cu)"
	(layer "B.Cu")
	(condition "A.Type == 'Track' && B.Type == 'Track' && !A.intersectsCourtyard('U1') && !B.intersectsCourtyard('U1')")
	(constraint clearance (min 0.15mm))
	(severity warning)
)

(rule "DFM Warning: Pad/Via Spacing (F.Cu)"
	(condition "A.Net != B.Net && A.existsOnLayer('F.Cu') && B.existsOnLayer('F.Cu') && (A.Type == 'Pad' || A.Type == 'Via' || A.Type == 'Track') && (B.Type == 'Pad' || B.Type == 'Via' || B.Type == 'Track') && (A.Type == 'Pad' || A.Type == 'Via' || B.Type == 'Pad' || B.Type == 'Via')")
	(constraint clearance (min 0.15mm))
	(severity warning)
)

(rule "DFM Warning: Pad/Via Spacing (B.Cu)"
	(condition "A.Net != B.Net && A.existsOnLayer('B.Cu') && B.existsOnLayer('B.Cu') && (A.Type == 'Pad' || A.Type == 'Via' || A.Type == 'Track') && (B.Type == 'Pad' || B.Type == 'Via' || B.Type == 'Track') && (A.Type == 'Pad' || A.Type == 'Via' || B.Type == 'Pad' || B.Type == 'Via')")
	(constraint clearance (min 0.15mm))
	(severity warning)
)

# --- Legend ---

(rule "JLCPCB: Minimum Line Width"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_thickness (min 0.15mm))
)

(rule "JLCPCB: Minimum Text Height"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_height (min 1mm))
)

(rule "JLCPCB: Pad to Silkscreen"
	(condition "A.Type == 'Pad' && ((A.existsOnLayer('F.Mask') && B.Layer == 'F.Silkscreen') || (A.existsOnLayer('B.Mask') && B.Layer == 'B.Silkscreen')) ")
	(constraint silk_clearance (min 0.15mm))
)


# --- Board Outlines ---

(rule "JLCPCB: Trace to Board Edge"
	(condition "A.Type == 'Track'")
  # Choose between:
  # Routed
	(constraint edge_clearance (min 0.3mm))
  # V-Cut Panel
	# (constraint edge_clearance (min 0.4mm))
)
